{
  "name": "neuroflow-designer",
  "version": "1.0.0",
  "description": "Figma development plugin to generate NeuroFlow AI workspace screens and design system tokens",
  "main": "dist/code.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017",
    "watch": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017 --watch"
  },
  "keywords": [
    "figma",
    "plugin",
    "neuroflow",
    "design-system",
    "ai-agents"
  ],
  "author": "NeuroFlow Architect",
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "^1.106.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.2"
  }
}
