# ==============================================================================
# NEUROFLOW ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=neuroflow-super-secure-secret-key-change-in-production-2026
ADMIN_EMAIL=admin@neuroflow.local
ADMIN_PASSWORD=adminneuroflow

# Database (PostgreSQL / PGLite)
# When DATABASE_URL is set, NeuroFlow connects to external PostgreSQL.
# When empty or left as "pglite://.data/neuroflow", NeuroFlow uses embedded WebAssembly PostgreSQL (zero setup).
DATABASE_URL=
# DATABASE_URL=postgresql://neuroflow:neuroflow_secret@localhost:5432/neuroflow

# Redis & Queue
# When REDIS_URL is set, NeuroFlow connects to Redis for BullMQ.
# When empty, NeuroFlow operates with embedded in-process memory queue (zero external dependencies).
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# Web Frontend URL (CORS)
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Worker Settings
WORKER_CONCURRENCY=5
EXECUTION_TIMEOUT_MS=60000
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_REQUEST_MAX_SIZE_BYTES=5242880
