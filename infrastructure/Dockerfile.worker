FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @neuroflow/shared build
RUN pnpm --filter @neuroflow/database build
RUN pnpm --filter @neuroflow/nodes build
RUN pnpm --filter @neuroflow/workflow-engine build
RUN pnpm --filter @neuroflow/worker build

CMD ["node", "apps/worker/dist/index.js"]
